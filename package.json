{
  "name": "ders-pdf-editor",
  "productName": "Ders PDF Editor",
  "version": "1.1.0",
  "description": "EGORA DIGITAL ve Yiğit Osman Bayrak tarafından geliştirilen ücretsiz PDF metin, sayfa ve not düzenleyicisi",
  "author": "EGORA DIGITAL / Yiğit Osman Bayrak",
  "repository": { "type": "git", "url": "https://github.com/AlgoWolfx/EPDF.git" },
  "homepage": "https://github.com/AlgoWolfx/EPDF",
  "bugs": { "url": "https://github.com/AlgoWolfx/EPDF/issues" },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "test": "node scripts/smoke.cjs"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "copyright": "Copyright © 2026 EGORA DIGITAL / Yiğit Osman Bayrak",
    "artifactName": "Ders-PDF-Editor-${version}-${arch}.${ext}",
    "appId": "com.ders.pdfeditor",
    "productName": "Ders PDF Editor",
    "files": [
      "main.js",
      "preload.js",
      "updates.js",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "renderer/**/*",
      "node_modules/pdfjs-dist/build/pdf.min.mjs",
      "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "node_modules/pdf-lib/dist/pdf-lib.min.js",
      "node_modules/@pdf-lib/fontkit/dist/fontkit.umd.min.js",
      "node_modules/@embedpdf/pdfium/dist/index.browser.js",
      "node_modules/@embedpdf/pdfium/dist/pdfium.wasm"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Belgesi",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "publish": { "provider": "github", "owner": "AlgoWolfx", "repo": "EPDF", "releaseType": "release" },
    "nsis": {
      "artifactName": "Ders-PDF-Editor-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Ders-PDF-Editor-${version}-${arch}-Portable.${ext}"
    }
  }
}
