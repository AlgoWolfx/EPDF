{
  "name": "ders-pdf-editor",
  "productName": "EPDF",
  "version": "2.0.0",
  "description": "EGORA DIGITAL ve Yiğit Osman Bayrak tarafından geliştirilen ücretsiz PDF metin, sayfa ve not düzenleyicisi",
  "author": "EGORA DIGITAL / Yiğit Osman Bayrak",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlgoWolfx/EPDF.git"
  },
  "homepage": "https://github.com/AlgoWolfx/EPDF",
  "bugs": {
    "url": "https://github.com/AlgoWolfx/EPDF/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "test": "node scripts/smoke.cjs"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/tur": "^1.0.0",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "copyright": "Copyright © 2026 EGORA DIGITAL / Yiğit Osman Bayrak",
    "artifactName": "EPDF-${version}-${arch}.${ext}",
    "appId": "com.ders.pdfeditor",
    "productName": "EPDF",
    "files": [
      "main.js",
      "preload.js",
      "updates.js",
      "licenses/**/*",
      "assets/**/*",
      "renderer/**/*",
      "node_modules/pdfjs-dist/build/pdf.min.mjs",
      "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "node_modules/pdf-lib/dist/pdf-lib.min.js",
      "node_modules/@pdf-lib/fontkit/dist/fontkit.umd.min.js",
      "node_modules/@embedpdf/pdfium/dist/index.browser.js",
      "node_modules/@embedpdf/pdfium/dist/pdfium.wasm",
      "node_modules/tesseract.js/dist/**/*",
      "node_modules/tesseract.js-core/*lstm.wasm.js",
      "node_modules/@tesseract.js-data/eng/4.0.0_best_int/**/*",
      "node_modules/@tesseract.js-data/tur/4.0.0_best_int/**/*",
      "node_modules/@tesseract.js-data/por/4.0.0_best_int/**/*",
      "!node_modules/@tesseract.js-data/*/4.0.0/**/*",
      "!node_modules/tesseract.js-core/*.wasm",
      "!node_modules/tesseract.js-core/tesseract-core.wasm.js",
      "!node_modules/tesseract.js-core/tesseract-core-simd.wasm.js",
      "!node_modules/tesseract.js-core/tesseract-core-relaxedsimd.wasm.js"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Belgesi",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "AlgoWolfx",
      "repo": "EPDF",
      "releaseType": "release"
    },
    "nsis": {
      "artifactName": "EPDF-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "EPDF-${version}-${arch}-Portable.${ext}"
    }
  }
}
